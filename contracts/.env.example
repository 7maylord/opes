# Arc testnet direct deployment and source verification only.
# Copy to contracts/.env; never put real secrets in this example.
# Deployment scripts are still pending. No Circle credentials are needed here.
# Network: Arc testnet, chain ID 5042002.
# https://docs.arc.io/arc/tutorials/deploy-on-arc
ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.io"
ARC_VERIFIER_URL="https://explorer.testnet.arc.io/api/"

# Dedicated testnet deployer: 0x-prefixed private key; needs test USDC for gas.
# An encrypted Foundry keystore can be used instead when running deployment.
DEPLOYER_PRIVATE_KEY=""

# Existing vault constructor inputs. ERC-20 USDC uses 6 decimals on Arc.
ARC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"
# Nonzero bytes32 organization identifier; generate from your stable org label:
# cast keccak "opes:arc-testnet:your-org-id"
OPES_ORGANIZATION_DOMAIN=""
OPES_OWNER_ADDRESS=""
# Operator MUST differ from the owner and recovery wallet.
OPES_OPERATOR_ADDRESS=""
# Pauser and recovery MAY both use the owner address for this test deployment.
OPES_PAUSER_ADDRESS=""
OPES_RECOVERY_ADDRESS=""

# Escrow receives the deployed vault address and the same owner automatically.
# Contract addresses and transactions belong in the deployment output manifest.
# Public Blockscout verification does not require an API key.
