# Arc testnet factory deployment and source verification only.
# Copy to contracts/.env; never put real secrets in this example.
# Deployment scripts are still pending. No Circle credentials are needed here.
# Network: Arc testnet, chain ID 5042002.
# https://docs.arc.io/arc/tutorials/deploy-on-arc
ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.io"
ARC_VERIFIER_URL="https://explorer.testnet.arc.io/api/"

# Dedicated testnet deployer: 0x-prefixed private key; needs test USDC for gas.
# An encrypted Foundry keystore can be used instead when running deployment.
DEPLOYER_PRIVATE_KEY=""

# Fixed token for tenant instances created by this factory (6 ERC-20 decimals).
ARC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"
# Platform address authorized to rotate/revoke provisioners; not a tenant owner.
FACTORY_ADMIN_ADDRESS=""
# OPES-funded caller that submits createOrganization and pays deployment gas.
FACTORY_PROVISIONER_ADDRESS=""

# Organization domain, owner, operator, pauser and recovery are per-signup inputs
# to createOrganization, not global environment variables. Tenant wallets can
# start with zero gas balance; the provisioner must have testnet USDC for gas.
# Factory/helper/tenant addresses and transactions belong in deployment manifests.
# Public Blockscout verification does not require an API key.
