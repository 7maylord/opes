# Copy to contracts/.env and fill in the blank values there.
# .env is gitignored. Keep credentials out of this template and frontend env files.
# This template prepares C8; deployment/verification scripts are still pending.

# Arc TESTNET only. Public defaults checked against official Arc docs.
# https://docs.arc.io/arc/tutorials/deploy-on-arc
ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.io"
ARC_CHAIN_ID="5042002"
ARC_EXPLORER_URL="https://explorer.testnet.arc.io"
ARC_VERIFIER_URL="https://explorer.testnet.arc.io/api/"
# Blockscout source verification uses ARC_VERIFIER_URL; no API key required
# by the documented public verification command.

# ERC-20 view of native USDC: 6 decimals (native gas accounting uses 18).
# https://docs.arc.io/integrate/infrastructure/indexing-events
ARC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"

# Required: stable organization ID and its nonzero bytes32 domain separator.
OPES_ORGANIZATION_ID=""
# Generate after choosing the ID, e.g. cast keccak "opes:arc-testnet:your-org-id"
OPES_ORGANIZATION_DOMAIN=""

# Required: nonzero 0x-prefixed wallet addresses.
# Owner administers the vault and escrow; initially also approves milestones.
OPES_OWNER_ADDRESS=""
# Dedicated organization execution wallet; MUST differ from the owner.
OPES_OPERATOR_ADDRESS=""
# Emergency pauser; may be the owner.
OPES_PAUSER_ADDRESS=""
# Organization-controlled recovery wallet; may be the owner, never the operator.
# Recovery destination and organization domain are immutable after deployment.
OPES_RECOVERY_ADDRESS=""

# Planned Circle deployment path. Use test-environment credentials/wallet IDs.
# Leave blank if not provisioned yet; provider support is checked before C8 deploys.
CIRCLE_API_KEY=""
# Registered 32-byte entity secret as 64 hexadecimal characters, without 0x.
# Keep the raw secret local; requests must use its encrypted ciphertext.
CIRCLE_ENTITY_SECRET=""
CIRCLE_DEPLOYER_WALLET_ID=""
CIRCLE_OPERATOR_WALLET_ID=""

# Direct Foundry fallback ONLY if Circle deployment cannot support this target
# and the limitation/import procedure is recorded. Not required for Circle signing.
# Dedicated testnet deployer private key: 0x + 64 hex characters.
# Its wallet needs testnet USDC for gas: https://faucet.circle.com/
DEPLOYER_PRIVATE_KEY=""

# Deployment outputs: leave blank until transactions are confirmed.
# Both contracts stay paused until source verification and configuration pass.
OPES_VAULT_ADDRESS=""
OPES_ESCROW_ADDRESS=""
