{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm api:generate",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "api:generate": "node scripts/generate-workspace-types.mjs",
    "test": "tsc --target es2022 --module nodenext --moduleResolution nodenext --outDir .next-test lib/session-cache.ts lib/setup-checklist.ts lib/money.ts && node --test tests/*.mjs",
    "test:e2e": "playwright test",
    "test:e2e:fullstack": "playwright test --config playwright.fullstack.config.ts"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.48.1",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.25.0"
}
