# Public API origin used by the browser. Point this to the Railway API URL in Vercel.
NEXT_PUBLIC_OPES_API_URL=http://localhost:3004
# Arc Testnet JSON-RPC endpoint used by Privy in the browser.
NEXT_PUBLIC_OPES_ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
# Public Privy app ID; use the same app as the backend. Never put the app secret here.
NEXT_PUBLIC_PRIVY_APP_ID=
