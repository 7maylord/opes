NODE_ENV=development
PORT=3004
OPES_ALLOWED_ORIGINS=http://localhost:3005
# Privy authentication. Keep the app secret in the backend environment only.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Circle developer-controlled wallet adapter used by the provisioning worker.
# Full testnet key from Circle Console: TEST_API_KEY:<key-id>:<secret>
CIRCLE_API_KEY=
# Generate and register a 32-byte secret; store its 64 hex characters here.
# This is the raw entity secret, not a reusable ciphertext or wallet private key.
# Keep the registration recovery file separately; never commit either secret.
CIRCLE_ENTITY_SECRET=
# Wallet-set, platform provisioner and tenant operator wallets are created and persisted.
# The worker reports the platform provisioner address; the current factory admin must
# grant it PROVISIONER_ROLE and fund bounded Arc testnet gas before factory calls run.
DATABASE_URL=postgresql://opes:opes@localhost:5433/opes
REDIS_URL=redis://localhost:6379
# Railway Storage Bucket credentials. Railway buckets expose an S3-compatible API;
# these local values point at MinIO from backend/docker-compose.yml.
RAILWAY_BUCKET_ENDPOINT=http://localhost:9000
RAILWAY_BUCKET_NAME=opes-local
RAILWAY_BUCKET_ACCESS_KEY_ID=opes_minio
RAILWAY_BUCKET_SECRET_ACCESS_KEY=opes_minio_password
RAILWAY_BUCKET_REGION=auto
RAILWAY_BUCKET_URL_STYLE=path
# Configure the bucket CORS policy to allow PUT from the Vercel frontend origin.
# Server-side invoice extraction and bounded decisions use DeepSeek Responses.
DEEPSEEK_API_KEY=
OPES_DEEPSEEK_MODEL=deepseek-flash
OPES_DEEPSEEK_BASE_URL=https://api.deepseek.com
OPES_LIQUIDITY_SANDBOX=true
# Legacy restricted signer/callback credentials are used only by unfinished
# cross-chain liquidity adapters. Arc direct payments use Circle credentials above.
OPES_PAYMENT_SIGNER_URL=
OPES_PAYMENT_SIGNER_TOKEN=
OPES_PAYMENT_WEBHOOK_SECRET=
OPES_OPERATIONS_TOKEN=
OPES_CCTP_ATTESTATION_URL=
OPES_GATEWAY_API_URL=
OPES_GATEWAY_MAX_FEE_ATOMIC=2010000
OPES_RPC_ARBITRUM_MAINNET=
OPES_RPC_ARBITRUM_SEPOLIA=
OPES_RPC_BASE_MAINNET=
OPES_RPC_BASE_SEPOLIA=
OPES_RPC_ARC_MAINNET=
OPES_RPC_ARC_TESTNET=https://rpc.testnet.arc.io
# Finalized Arc blocks scanned per tenant. Increase finality only if Arc reorg behavior requires it.
OPES_RECONCILIATION_FINALITY_BLOCKS=12
# Initial finalized-block history scanned when a tenant has no persisted cursor.
OPES_RECONCILIATION_BACKFILL_BLOCKS=5000
OPES_RPC_CELO_MAINNET=
OPES_RPC_CELO_SEPOLIA=
OPES_RPC_ETHEREUM_MAINNET=
OPES_RPC_ETHEREUM_SEPOLIA=
OPES_RPC_MONAD_MAINNET=
OPES_RPC_MONAD_TESTNET=
OPES_BASE_MAINNET_USDT_ADDRESS=
OPES_BASE_MAINNET_USDC_USDT_SWAP_PROVIDER=
OPES_BASE_MAINNET_USDC_USDT_SWAP_ROUTER=
OPES_BASE_MAINNET_USDC_USDT_MIN_OUTPUT_BPS=9900
# Optional capability. Leave all three empty to disable only Base Sepolia USDT;
# Gateway/CCTP USDC routes remain available. Tether publishes no Base Sepolia
# USDt and no usable USDC/USDt pool was found. Verified V3 SwapRouter02:
# 0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4
OPES_BASE_SEPOLIA_USDT_ADDRESS=
OPES_BASE_SEPOLIA_USDC_USDT_SWAP_PROVIDER=
OPES_BASE_SEPOLIA_USDC_USDT_SWAP_ROUTER=
OPES_BASE_SEPOLIA_USDC_USDT_MIN_OUTPUT_BPS=9900
